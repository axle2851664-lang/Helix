{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./dist/.tsbuildinfo-app",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@platform/*": ["src/platform/*"],
      "@ui/*": ["src/ui/*"],
      "@types/*": ["src/types/*"],
      "@hx/core": ["packages/core/src/index.ts"]
    }
  },
  "references": [{ "path": "./packages/core" }],
  "include": ["src"]
}
