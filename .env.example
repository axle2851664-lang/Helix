# Copy this file to `.env` next to the Helix executable (or in this folder
# when running `npm run tauri:dev`) and fill in the keys you have.
#
# The shell reads this file once at startup, before anything asks for a key,
# and never overwrites a variable that is already set in the environment - so
# a real environment variable always wins over a line here.
#
# These values are read in Rust and never reach the web view. Helix has no
# setting that holds a secret, on purpose: a value the page can read is a
# value anything running in the page can read.
#
# Nothing here is required. Helix's ordinary conversation runs on a local
# model through Ollama, which needs no key at all.

# --- language models ---------------------------------------------------------

# Mistral. Paid, per token.
MISTRAL_API_KEY=

# Cerebras.
CEREBRAS_API_KEY=

# Google Gemini. Also used for Google services.
GEMINI_API_KEY=

# Anthropic. The shell can reach it, but no provider is built on the
# TypeScript side yet, so the Claude models still report as unavailable.
ANTHROPIC_API_KEY=

# --- voice -------------------------------------------------------------------

# ElevenLabs, for speech recognition and synthesis. Recognition through this
# key sends microphone audio to ElevenLabs; Whisper on this machine remains the
# default and nothing falls back to ElevenLabs on its own. Choose it in
# Settings > Voice, and pick a voice there too - Helix will not choose one for
# you.
ELEVENLABS_API_KEY=

# --- web search and images ---------------------------------------------------

BRAVE_API_KEY=
GOOGLE_SEARCH_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
