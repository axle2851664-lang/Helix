{
  "name": "helix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Helix - modular portable Windows AI assistant",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
