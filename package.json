{
  "name": "helix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Helix - modular portable Windows AI assistant",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "fetch:models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
