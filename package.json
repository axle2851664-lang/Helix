  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
